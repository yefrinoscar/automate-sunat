{
  "name": "automate-sunat-desktop",
  "private": true,
  "version": "1.0.2",
  "type": "commonjs",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ELECTRON_IS_DEV=1 electron dist/src/main.js",
    "generate-icons": "node tools/generate-icons.cjs",
    "build": "tsc -p tsconfig.json",
    "package": "npm --prefix .. run build && node tools/prepare-app-bundle.cjs && npm run generate-icons && npm run build && electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.5.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "wait-on": "^8.0.5"
  }
}
