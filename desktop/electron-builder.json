{
  "appId": "com.automate-sunat.desktop",
  "productName": "Automate SUNAT",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**"
  ],
  "extraResources": [
    {
      "from": "release/app-bundle",
      "to": "app-bundle",
      "filter": ["**/*"]
    },
    {
      "from": "release/pw-browsers",
      "to": "pw-browsers",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "linux": {
    "icon": "assets/icons",
    "target": ["AppImage"]
  },
  "mac": {
    "target": ["dmg"]
  },
  "win": {
    "target": ["nsis"]
  }
}
